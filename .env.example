# TECHNOVA - Environment Configuration
# Copy this to .env and fill in your values

# ── Database ─────────────────────────────────────────────
# Default: SQLite (no setup needed for local dev)
DATABASE_URL=sqlite:///./technova.db

# ── Security ─────────────────────────────────────────────
SECRET_KEY=super-secret-technova-key-2026
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT_MB=512

# ── AI Keys (optional for demo mode) ─────────────────────
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# LLM_MODEL=gpt-4o-mini
